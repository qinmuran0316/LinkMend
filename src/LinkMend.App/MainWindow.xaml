<Window x:Class="LinkMend.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkMend · 快捷方式诊断与修复"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="Manual"
        Background="{StaticResource PageBackground}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid Margin="20,26,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource Accent}">
                        <TextBlock Text="LM"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LinkMend"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="快捷方式诊断与修复"
                                   Foreground="{StaticResource SidebarMuted}"
                                   FontSize="10.5"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,42,0,0">
                    <TextBlock Text="工作台"
                               Foreground="#64748B"
                               FontSize="10.5"
                               Margin="13,0,0,8" />
                    <RadioButton x:Name="NavDiagnosis"
                                 GroupName="Navigation"
                                 Style="{StaticResource SidebarNavStyle}"
                                 Content="诊断与修复"
                                 IsChecked="True"
                                 Checked="NavDiagnosis_Checked" />
                    <RadioButton x:Name="NavHistory"
                                 GroupName="Navigation"
                                 Style="{StaticResource SidebarNavStyle}"
                                 AutomationProperties.AutomationId="NavHistory"
                                 Content="修复历史"
                                 Checked="NavHistory_Checked" />
                    <RadioButton x:Name="NavAbout"
                                 GroupName="Navigation"
                                 Style="{StaticResource SidebarNavStyle}"
                                 Content="关于与安全"
                                 Checked="NavAbout_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="{StaticResource SidebarHover}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="安全优先"
                                       Foreground="#E2E8F0"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="扫描不启动程序。修改前备份，写入后重新校验。"
                                       Foreground="{StaticResource SidebarMuted}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       LineHeight="17"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionText}"
                               Foreground="#64748B"
                               FontSize="10"
                               Margin="2,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <!-- Diagnosis page -->
            <Grid x:Name="DiagnosisPage" Margin="30,24,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="快捷方式健康检查" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="找出白图标、失效目标和数据目录冲突；修复前先备份，可随时撤销。"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="自动搜索并修复"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="AutoRepairButton"
                                IsEnabled="{Binding CanAutoRepair}"
                                Click="AutoRepair_Click"
                                Margin="0,0,8,0" />
                        <Button Content="开始检查"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="ScanButton"
                                IsEnabled="{Binding CanInteract}"
                                Click="Scan_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}"
                        Padding="18,15"
                        Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="扫描范围" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="只读取快捷方式，不会启动目标程序"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Content="桌面"
                                          Style="{StaticResource FluentCheckBox}"
                                          IsChecked="{Binding ScanDesktop, Mode=TwoWay}"
                                          Margin="0,0,22,6" />
                                <CheckBox Content="开始菜单"
                                          Style="{StaticResource FluentCheckBox}"
                                          IsChecked="{Binding ScanStartMenu, Mode=TwoWay}"
                                          Margin="0,0,22,6" />
                                <Button Content="+ 添加文件夹"
                                        Style="{StaticResource LinkButtonStyle}"
                                        AutomationProperties.AutomationId="AddFolderButton"
                                        Click="AddFolder_Click"
                                        Margin="0,0,0,6" />
                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding CustomFolders}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoft}"
                                                CornerRadius="6"
                                                Padding="8,3,5,3"
                                                Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Accent}"
                                                           MaxWidth="330"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button Content="×"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        FontSize="12"
                                                        Width="18"
                                                        Height="18"
                                                        Padding="0"
                                                        Margin="4,0,0,0"
                                                        Tag="{Binding}"
                                                        Click="RemoveFolder_Click"
                                                        ToolTip="从扫描范围移除" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasDroppedFiles, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DroppedSummary}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <Button Content="清除"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Click="ClearDropped_Click"
                                        Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="也可以把 .lnk 文件或文件夹拖入窗口。"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceAltBackground}"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,11"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                MaxWidth="255">
                            <StackPanel>
                                <TextBlock Text="扫描发现问题时"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="先看左侧判断依据，再定位新路径或预览修复。"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,14,0,14">
                    <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="已扫描" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding ScannedCount}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="需要关注" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding ProblemCount}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Amber}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="可修复或定位" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding RepairableCount}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="正常" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{Binding HealthyCount}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Green}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="365" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="16,14"
                            Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="检查结果" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="按严重程度排序"
                                               Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding FilterOptions}"
                                              SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                              Style="{StaticResource FluentComboBox}"
                                              Width="112" />
                                    <Button Content="全选可处理"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Click="SelectAllRepairable_Click"
                                            Margin="10,0,0,0" />
                                    <Button Content="清空"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="ClearSelection_Click"
                                            Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <ListBox Grid.Row="1"
                                     Margin="0,10,0,0"
                                     ItemsSource="{Binding Rows}"
                                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                     Style="{StaticResource ResultListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource FluentCheckBox}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsSelectable}"
                                                      ToolTip="{Binding CheckBoxToolTip}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1"
                                                        Margin="2,0,12,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding PrimarySummary}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Fill="{Binding Health, Converter={StaticResource HealthBrush}}"
                                                             Margin="0,0,7,0"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FilePath}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="14,3,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PrimaryTitle}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />

                                            <Border Grid.Column="3"
                                                    Style="{StaticResource BadgeBorderStyle}"
                                                    Background="{Binding Health, Converter={StaticResource HealthBackground}}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border Width="54"
                                        Height="54"
                                        CornerRadius="16"
                                        Background="{StaticResource AccentSoft}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="⌕"
                                               FontSize="27"
                                               Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="还没有检查结果"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0" />
                                <TextBlock Text="选择扫描范围，点击右上角“开始检查”。"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CheckedCount, StringFormat='已选择 {0} 项'}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="清空选择"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="ClearSelection_Click" />
                                    <Button Content="预览并修复已选"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            AutomationProperties.AutomationId="RepairSelectedButton"
                                            IsEnabled="{Binding CanRepairSelected}"
                                            Click="RepairSelected_Click"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
                                <Border Width="46"
                                        Height="46"
                                        CornerRadius="14"
                                        Background="{StaticResource SurfaceAltBackground}">
                                    <TextBlock Text="↗"
                                               FontSize="22"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="选择一个快捷方式"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="这里会显示诊断依据、路径对照和建议操作。"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           MaxWidth="250"
                                           TextAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding SelectedRow, Converter={StaticResource NotNullToVisibility}}">
                                <StackPanel DataContext="{Binding SelectedRow}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FilePath}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Style="{StaticResource BadgeBorderStyle}"
                                                Background="{Binding Health, Converter={StaticResource HealthBackground}}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,12,0,14" />

                                    <TextBlock Text="问题与判断依据" Style="{StaticResource SectionTitleStyle}" />
                                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceAltBackground}"
                                                        CornerRadius="9"
                                                        Padding="11,9"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6"
                                                                     Height="6"
                                                                     Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                                     Margin="0,0,7,0"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   FontSize="12"
                                                                   Margin="13,4,0,0" />
                                                        <ItemsControl ItemsSource="{Binding Evidence}" Margin="13,6,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="11" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="•"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextMuted}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextSecondary}"
                                                                                   TextWrapping="Wrap"
                                                                                   LineHeight="17" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="{StaticResource GreenSoft}"
                                            CornerRadius="9"
                                            Padding="11,9"
                                            Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="未发现可确定的目标、起始位置或图标问题。白图标如果仍存在，可能是 Windows 图标缓存问题，本版不会强制清理。"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource Green}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18" />
                                    </Border>

                                    <TextBlock Text="路径对照" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="67" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="扫描位置" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,7" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScopeLabel}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,7" />

                                        <TextBlock Grid.Row="1" Text="目标" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,7" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding TargetDisplay}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,7" />

                                        <TextBlock Grid.Row="2" Text="起始位置" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,7" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding WorkingDirectoryDisplay}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,7" />

                                        <TextBlock Grid.Row="3" Text="图标" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Text="{Binding IconDisplay}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Border Background="{StaticResource AccentSoft}"
                                            CornerRadius="9"
                                            Padding="11,9"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding HasCandidate, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="已选择的新位置"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding CandidateDisplay}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding CandidateReasons}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TextMuted}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="建议" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Suggestion}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="11.5"
                                               Margin="0,5,0,8" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,0"
                                    Visibility="{Binding SelectedRow, Converter={StaticResource NotNullToVisibility}}">
                                <WrapPanel>
                                    <Button Content="查找新位置"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.AutomationId="FindRelocationButton"
                                            Click="FindRelocation_Click"
                                            Visibility="{Binding SelectedRow.NeedsRelocation, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="修复此项"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            AutomationProperties.AutomationId="FixSelectedButton"
                                            IsEnabled="{Binding SelectedRow.CanApplyFix}"
                                            Visibility="{Binding SelectedRow.CanApplyFix, Converter={StaticResource BoolToVisibility}}"
                                            Click="FixSelected_Click"
                                            Margin="7,0,0,0" />
                                    <Button Content="打开所在文件夹"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OpenShortcutFolder_Click"
                                            Margin="3,0,0,0" />
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="120"
                                     Style="{StaticResource FluentProgressBar}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                     Minimum="0"
                                     Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                     Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   MaxWidth="760"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding ProgressText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Content="取消检查"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="CancelScan_Click"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- History page -->
            <Grid x:Name="HistoryPage"
                  Margin="30,24,30,22"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="修复历史" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="每次修改都有本地备份。撤销前会检查文件是否在修复后被改动。"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="打开备份目录"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenBackupFolder_Click"
                                Margin="0,0,8,0" />
                        <Button Content="刷新"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="RefreshHistory_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14,12"
                            Margin="0,0,14,0">
                        <Grid>
                            <ListBox ItemsSource="{Binding HistoryRows}"
                                     SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                     Style="{StaticResource ResultListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OperationLabel}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding TimeText}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               VerticalAlignment="Center"
                                                               Margin="9,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Style="{StaticResource BadgeBorderStyle}"
                                                    Background="{StaticResource SurfaceAltBackground}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StateLabel}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="还没有修复记录"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="完成一次修复后，备份与撤销记录会出现在这里。"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="260"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,18">
                        <Grid>
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding SelectedHistory, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="选择一条历史记录"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="查看修改前后的字段，并在冲突检查通过后一键撤销。"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <Grid DataContext="{Binding SelectedHistory}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DetailHeading}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding BatchId}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Content="撤销此批次"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.AutomationId="UndoBatchButton"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Click="UndoBatch_Click"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,14,0,0">
                                    <StackPanel>
                                        <Border Background="{StaticResource AccentSoft}"
                                                CornerRadius="9"
                                                Padding="11,9">
                                            <TextBlock Text="{Binding UndoHint}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Text="{Binding Note}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,8,0,0" />

                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceAltBackground}"
                                                            CornerRadius="9"
                                                            Padding="12,10"
                                                            Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                           HorizontalAlignment="Right"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding ShortcutPath}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Margin="0,3,0,0" />
                                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="0,5,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{StaticResource TextSecondary}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,1" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding Message}"
                                                                       Style="{StaticResource CaptionTextStyle}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock Grid.Row="2"
                                           Text="备份目录中的快照是原始 .lnk 文件；撤销前 LinkMend 会再次校验当前内容。"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,10,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- About page -->
            <ScrollViewer x:Name="AboutPage"
                          Margin="30,24,30,22"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="关于 LinkMend" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="一个中文优先、只做可解释修复的 Windows 快捷方式诊断工具。"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,5,0,0" />

                    <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="设计原则" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="1. 先判断原因，再提出修改：区分目标丢失、磁盘离线、权限不足、图标索引失效和特殊快捷方式。"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="2. 不猜测：同名程序、多个数据目录和不确定的图标缓存问题会要求你确认，不自动选择或覆盖。"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="3. 写入前备份、写入后校验：原始 .lnk 快照保存在本地；撤销前会检查文件是否又被其他程序修改。"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="4. 最小权限：以普通用户身份运行，不主动提权；扫描不会启动目标程序。"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="支持与限制" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="支持：目标/起始位置/图标路径与索引诊断；同名程序搜索（安装记录 + 有限目录扫描）；显式 --user-data-dir/--data-dir 等参数冲突提示；备份、撤销和冲突保护。"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="限制：不清理 Windows 图标缓存；不解析特殊 Shell 命名空间快捷方式；不会自动删除启动参数；目录搜索设有上限，便携软件可手动添加搜索目录。"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="数据目录检测仅分析明确的启动参数，不代表应用的完整配置来源；多个数据目录可能是有意隔离。"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="本地数据" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding BackupRootDisplay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding BackupHistoryDisplay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SettingsDisplay}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="语言 / Language:"
                                           Style="{StaticResource BodyTextStyle}"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          Style="{StaticResource FluentComboBox}"
                                          Width="150"
                                          Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="所有备份和设置只保存在本机；LinkMend 不上传快捷方式或程序信息。"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="11.5"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="项目信息" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding VersionDisplay}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="源代码：github.com/qinmuran0316/LinkMend"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="设计参考：ShellLink (.NET COM 互操作)、LnkParse3 (异常快捷方式解析思路)、WPF UI (Fluent 视觉方向)。本版使用原生 WPF 样式，以减少发布依赖。"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
